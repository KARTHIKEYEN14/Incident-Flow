# ============================================================================
# IncidentFlow Testkit Configuration
# ============================================================================

# Local Ollama endpoint and model configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=90

# Generation controls (max test cases generated per command: 1 to 10, default: 5)
MAX_TESTS_PER_BATCH=5

# Test database isolation (default: in-memory SQLite with auto-JSONB adapter)
# NEVER use production database credentials!
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
# Or a dedicated test PostgreSQL database:
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/incident_warroom_test

# Backend path relative to testkit or absolute path
INCIDENTFLOW_BACKEND_PATH=../backend
