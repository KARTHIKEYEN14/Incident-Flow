# Collaborative Incident & Outage War Room

# Database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/incident_warroom
DATABASE_URL_SYNC=postgresql+psycopg://postgres:yourpassword@localhost:5432/incident_warroom

# JWT
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
BACKEND_URL=http://127.0.0.1:8000
WS_URL=ws://127.0.0.1:8000
